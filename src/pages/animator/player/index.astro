---
import BaseLayout from "../../../layouts/BaseLayout.astro";

// Lottie Animator's preview player — the UNIFIED player (public/app/player) opened on the
// Lottie player, so a dropped Lottie plays with airbnb lottie-web and can be switched to the
// LottieFiles (dotLottie) player from the transport bar. It reads Pixodesk JSON and
// pre-rendered SVG too; this page only picks the starting player.
//
// Published by `yarn website:player` in the private app repo — don't edit public/app/player by
// hand, re-run the command.
---

<BaseLayout title="Lottie Animator Preview Player">
  <div class="pt-navDouble flex flex-col flex-1 bg-black">
    <iframe
      src="/app/player/index.html?player=lottie"
      title="Pixodesk Lottie Animator — Preview Player"
      class="w-full flex-1 min-h-[calc(100vh-5rem)] border-0"
    ></iframe>
  </div>
</BaseLayout>
