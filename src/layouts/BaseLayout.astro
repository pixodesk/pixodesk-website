---
import Footer from "./Footer.astro";
import Menu from "./Menu.astro";

import "../styles/tailwind.css";
import "../styles/global.scss";

interface Props {
    /** With a description the head also gets canonical + Open Graph + Twitter tags (new-design pages; old pages pass none). */
    description?: string;
    ogImage?: string;
    canonical?: string;
    noindex?: boolean;
    title?: string;
    color?: string;
    bgColor?: string;
    hoverText?: string;
}

const { title, color, bgColor, hoverText, description, ogImage, canonical, noindex } = Astro.props;
const fullTitle = title ? `${title} - Pixodesk` : "Pixodesk - SVG & Lottie Animations";
const pageUrl = new URL(canonical ?? Astro.url.pathname, Astro.site ?? Astro.url).href;
const imageUrl = new URL(ogImage ?? "/assets/index/hero/px-apps-screenshot-1400.jpg", Astro.site ?? Astro.url).href;
---

<html lang="en">
    <head>
        <title>
            {
                title
                    ? `${title} - Pixodesk`
                    : "Pixodesk - SVG & Lottie Animations"
            }
        </title>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        {noindex && <meta name="robots" content="noindex" />}
        {
            description && (
                <>
                    <meta name="description" content={description} />
                    <link rel="canonical" href={pageUrl} />
                    <meta property="og:type" content="website" />
                    <meta property="og:site_name" content="Pixodesk" />
                    <meta property="og:title" content={fullTitle} />
                    <meta property="og:description" content={description} />
                    <meta property="og:url" content={pageUrl} />
                    <meta property="og:image" content={imageUrl} />
                    <meta name="twitter:card" content="summary_large_image" />
                    <meta name="twitter:title" content={fullTitle} />
                    <meta name="twitter:description" content={description} />
                    <meta name="twitter:image" content={imageUrl} />
                </>
            )
        }
    </head>
    <body class="font-sans min-h-screen flex flex-col bg-black">
        <script
            async
            src="https://analytics.umami.is/script.js"
            data-website-id="33c2779d-0e25-4964-90c1-11ce29d69fd6"></script>

        <Menu
            color={color}
            bgColor="bg-[#00010e]"
            bgSubColor="bg-[#00010e]"
            hoverText={hoverText}
        />
        <main class="flex flex-col flex-1">
            <!-- <main class="relative"> -->
            <slot />
        </main>
        <Footer />
    </body>
</html>
