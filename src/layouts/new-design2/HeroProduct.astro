---
/**
 * The hero's art: the animation at work inside a product. A browser window (drawn in CSS) holds the flight search
 * card as its learn video ends — the plane flies while the search runs; the file dialog overlaps its corner and opens
 * its bin when pointed at. Phones: the window, then the dialog under it.
 */
import RealUiCard from "./RealUiCard.astro";
---
<div class="hp">
  <div class="hp-window">
    <div class="hp-bar"><i class="red"></i><i class="amber"></i><i class="green"></i><span>yourapp.com/flights</span></div>
    <div class="hp-page"><RealUiCard id="flight" /></div>
  </div>
  <div class="hp-dialog">
    <span class="hp-hint">point at Delete</span>
    <RealUiCard id="hover" />
  </div>
</div>
<style>
  .hp { position: relative; width: 100%; max-width: 720px; margin: 0 auto; padding: 32px 16px 72px; }
  .hp-window { overflow: hidden; border-radius: 14px; border: 1px solid rgba(255, 255, 255, .15); background: #eef1f6; box-shadow: 0 30px 80px rgba(0, 0, 0, .45); }
  .hp-bar { display: flex; align-items: center; gap: 7px; padding: 9px 12px; background: #dfe3ea; border-bottom: 1px solid rgba(0, 0, 0, .08); }
  .hp-bar i { width: 11px; height: 11px; border-radius: 50%; display: block; }
  .hp-bar .red { background: #ff5f57; } .hp-bar .amber { background: #febc2e; } .hp-bar .green { background: #28c840; }
  .hp-bar span { margin-left: 10px; flex: 1; border-radius: 6px; background: #fff; padding: 3px 10px; text-align: left; font: 12px system-ui, sans-serif; color: #64748b; }
  .hp-page { padding: 0 8px 4px; }
  .hp-dialog { position: relative; margin-top: 28px; }
  .hp-hint { position: absolute; z-index: 2; top: 18px; left: 50%; transform: translateX(-200px); border-radius: 999px; background: #67e8f9; padding: 3px 12px; font: 600 12px system-ui, sans-serif; color: #0f172a; box-shadow: 0 4px 12px rgba(0, 0, 0, .3); }
  @media (min-width: 900px) {
    .hp { padding-bottom: 120px; }
    .hp-dialog { position: absolute; right: -150px; bottom: 30px; width: 460px; margin: 0; }
    .hp-hint { top: 20px; left: 30px; transform: none; }
  }
</style>
