---
/**
 * Animator Studio — "One toolbox" (owner, 2026-10-18: show, don't say, why both editors in one app): a Venn of the two editors.
 * - The middle: the feature sections both app pages show; each side: its app's own (catalogue SECTIONS — never listed here).
 * - Each side also names its app (link to its page), its pitch and the files it opens and saves (fileFormats.ts).
 * - Phones: three stacked cards, no lobes.
 */
import LogoSvgaFill from "../../LogoSvgaFill.astro";
import Logo2DFill from "../../Logo2DFill.astro";
import DiagramStyles from "../home/DiagramStyles.astro";
import Marked from "../home/Marked.astro";
import { pitchOf } from "../apps";
import { FORMATS_PER_APP } from "../fileFormats";
import { AppKey, GroupKey, SECTIONS, type SectionInfo, appInfo, groupInfo, sectionHref } from "../catalogue";

/** The groups that hold the tools (not the intro, the uses or the closing band). */
const TOOL_GROUPS = [GroupKey.animate, GroupKey.draw, GroupKey.effects];
const [LEFT, RIGHT] = [AppKey.animator2d, AppKey.svgAnimator];
const tools = SECTIONS.filter((s) => TOOL_GROUPS.includes(s.group));
const has = (s: SectionInfo, app: AppKey) => s.apps.includes(app);
const byGroup = (list: Array<SectionInfo>) => TOOL_GROUPS.map((g) => ({ name: groupInfo(g).name, items: list.filter((s) => s.group === g) })).filter((g) => g.items.length);
const shared = byGroup(tools.filter((s) => has(s, LEFT) && has(s, RIGHT)));
const side = (app: AppKey, other: AppKey) => {
  const p = pitchOf(app);
  return { app, name: appInfo(app).name, page: appInfo(app).page, accent: p.accent, tagline: p.tagline, opens: FORMATS_PER_APP[app].own,
    only: tools.filter((s) => has(s, app) && !has(s, other)) };
};
const sides = [side(LEFT, RIGHT), side(RIGHT, LEFT)];
---
<DiagramStyles />
<section class="dg-section">
  <div class="dg-head">
    <h2>One toolbox</h2>
    <p>Learn it once — each editor adds its own.</p>
  </div>
  <div class="venn" style={`--left: ${sides[0].accent}; --right: ${sides[1].accent}`}>
    <span class="lobe lobe-left" aria-hidden="true"></span><span class="lobe lobe-right" aria-hidden="true"></span>
    {sides.map((s, i) => (
      <div class:list={["side", i ? "side-right" : "side-left"]} style={`--accent: ${s.accent}`}>
        <a class="who" href={s.page}>
          <span class="dg-logo">{s.app === AppKey.animator2d ? <Logo2DFill /> : <LogoSvgaFill />}</span>
          <span class="dg-text"><span class="dg-name">{s.name}</span><span class="dg-sub">{s.tagline}</span></span>
        </a>
        <p class="label">Opens and saves</p>
        <ul class="files">{s.opens.map((f) => <li><b>{f.label}</b> <Marked text={f.sub} chips /></li>)}</ul>
        <p class="label">Only here</p>
        <ul class="chips">{s.only.map((t) => <li><a class="chip own" href={sectionHref(t.slug, s.app)}>{t.title}</a></li>)}</ul>
      </div>
    ))}
    <div class="mid">
      <p class="label both">In both</p>
      {shared.map((g) => (
        <div class="group">
          <p class="group-name">{g.name}</p>
          <ul class="chips">{g.items.map((t) => <li><span class="chip">{t.title}</span></li>)}</ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* the lobes: two ellipses, each in its app's colour; the overlap (the middle column) brightens where they meet */
  .venn { position: relative; display: grid; grid-template-columns: minmax(0, 37fr) minmax(0, 26fr) minmax(0, 37fr); grid-template-areas: "l m r";
    align-items: center; max-width: 1180px; min-height: 520px; margin: 0 auto; }
  .lobe { position: absolute; top: 0; bottom: 0; width: 63%; border-radius: 50%; mix-blend-mode: screen; pointer-events: none; }
  .lobe-left { left: 0; border: 1px solid color-mix(in srgb, var(--left) 45%, transparent);
    background: radial-gradient(ellipse at 30% 45%, color-mix(in srgb, var(--left) 22%, transparent), color-mix(in srgb, var(--left) 8%, transparent) 70%); }
  .lobe-right { right: 0; border: 1px solid color-mix(in srgb, var(--right) 45%, transparent);
    background: radial-gradient(ellipse at 70% 45%, color-mix(in srgb, var(--right) 22%, transparent), color-mix(in srgb, var(--right) 8%, transparent) 70%); }
  .side { position: relative; display: flex; flex-direction: column; gap: 8px; }
  .side-left { grid-area: l; padding: 40px 28px 40px 16%; }
  .side-right { grid-area: r; padding: 40px 16% 40px 28px; }
  .mid { position: relative; grid-area: m; display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 30px 6px; text-align: center; }
  .who { display: grid; grid-template-columns: 44px minmax(0, 1fr); align-items: center; gap: 12px; margin-bottom: 10px; color: #fff; text-decoration: none; }
  .who:hover .dg-name { text-decoration: underline; text-underline-offset: 3px; }
  .label { font-size: 11.5px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #94a3b8; margin-top: 6px; }
  .label.both { font-size: 13px; color: #fde68a; }
  .group-name { font-size: 12px; color: #94a3b8; margin-bottom: 6px; }
  .files { display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: #cbd5e1; }
  .files b { color: #fff; font-weight: 700; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .mid .chips { justify-content: center; }
  .chip { display: inline-block; padding: 4px 11px; border-radius: 999px; font-size: 13px; font-weight: 600; color: #f8fafc; background: rgba(15, 23, 42, .7); border: 1px solid rgba(255, 255, 255, .16); }
  .chip.own { color: #fff; text-decoration: none; background: color-mix(in srgb, var(--accent) 20%, rgba(15, 23, 42, .8)); border-color: color-mix(in srgb, var(--accent) 55%, transparent); transition: border-color .2s; }
  .chip.own:hover { border-color: var(--accent); }
  @media (max-width: 1023px) {
    .venn { grid-template-columns: minmax(0, 1fr); grid-template-areas: "l" "m" "r"; gap: 14px; min-height: 0; max-width: 520px; }
    .lobe { display: none; }
    .side, .mid { padding: 20px; border-radius: 22px; }
    .side { background: color-mix(in srgb, var(--accent) 12%, rgba(15, 23, 42, .85)); border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent); }
    .mid { background: linear-gradient(180deg, color-mix(in srgb, var(--left) 14%, rgba(15, 23, 42, .85)), color-mix(in srgb, var(--right) 14%, rgba(15, 23, 42, .85))); border: 1px solid rgba(255, 255, 255, .14); }
  }
</style>
