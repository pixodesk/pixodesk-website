---
/** The diagrams' shared look (the home's decision tree and how it fits together, the app pages' triggers): the dark section with a dot
 *  grid, step headings, glass nodes with a big white word, app rows (logo, name, one small line, a round arrow), place rows (glyph, name,
 *  one small line), the lit and limited states. */
---
<style is:global>
  .dg-section, [data-diagram] { --traced: 251 191 36; }
  .dg-section { position: relative; overflow: hidden; padding: 84px 20px 96px; color: #fff;
    background: radial-gradient(ellipse at 18% 30%, rgba(34, 211, 238, .10), transparent 45%), radial-gradient(ellipse at 85% 75%, rgba(244, 114, 182, .10), transparent 45%), linear-gradient(180deg, #05030d, #0b0a1f 50%, #05030d); }
  .dg-section::before { content: ""; position: absolute; inset: 0; background-image: radial-gradient(rgba(165, 180, 252, .14) 1px, transparent 1.2px); background-size: 26px 26px;
    -webkit-mask-image: radial-gradient(ellipse at 50% 55%, #000 30%, transparent 75%); mask-image: radial-gradient(ellipse at 50% 55%, #000 30%, transparent 75%); pointer-events: none; }
  .dg-head { position: relative; text-align: center; margin-bottom: 44px; }
  .dg-head h2 { font-size: clamp(30px, 4vw, 48px); font-weight: 800; letter-spacing: -0.02em; padding: 0; }
  .dg-head p { margin-top: 8px; color: #94a3b8; }
  .dg-node { position: relative; z-index: 1; }
  .dg-fork { display: flex; flex-direction: column; gap: 6px; padding: 12px 18px; border-radius: 16px; color: #fff; text-decoration: none; background: rgba(15, 23, 42, .78); border: 1px solid rgba(255, 255, 255, .12); backdrop-filter: blur(6px); transition: border-color .2s, box-shadow .2s, opacity .25s; }
  .dg-fork b { font-size: 26px; font-weight: 800; line-height: 1.1; color: #fff; }
  .dg-fork span { font-size: 12.5px; color: #94a3b8; line-height: 1.35; }
  /* a node in its app's colour (--accent): what the editor sets */
  .dg-fork.dg-accent { background: linear-gradient(160deg, color-mix(in srgb, var(--accent) 24%, rgba(15, 23, 42, .85)), rgba(15, 23, 42, .85) 70%); border-color: color-mix(in srgb, var(--accent) 50%, transparent); }
  .dg-fork.lit { border-color: rgb(var(--traced) / .8); box-shadow: 0 0 30px -10px rgb(var(--traced) / .7); }
  /* reached only through a secondary route (an export): works, with limits */
  [data-diagram] .dg-node.limited { border-style: dashed; }
  .dg-app { display: grid; grid-template-columns: 44px minmax(0, 1fr) 30px; align-items: center; gap: 14px; padding: 12px 16px; border-radius: 18px; text-decoration: none; color: #fff;
    background: linear-gradient(160deg, rgba(28, 39, 71, .85), rgba(10, 16, 32, .92)); border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    box-shadow: 0 18px 40px -26px var(--accent); transition: transform .2s, box-shadow .2s, border-color .2s, opacity .25s; }
  /* traced like every other node (gold); the logo and arrow keep the app's accent */
  .dg-app:hover, .dg-app.lit { transform: translateX(4px); border-color: rgb(var(--traced) / .85); box-shadow: 0 0 0 1px rgb(var(--traced) / .7), 0 22px 50px -24px rgb(var(--traced) / .9); }
  .dg-logo { width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; border-radius: 12px; color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent); border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent); }
  .dg-logo svg { width: 24px; height: 24px; fill: currentColor; }
  .dg-mark { font-size: 22px; }
  .dg-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .dg-name { font-size: 18px; font-weight: 800; }
  .dg-sub { font-size: 12.5px; line-height: 1.4; color: #94a3b8; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dg-price { font-weight: 700; color: var(--accent); }
  /* a diagram's single source: a glowing circle (the decision tree's "Your graphic", Where it plays' app) — a big word, a small line */
  .dg-root { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; width: 190px; max-width: 100%; aspect-ratio: 1; margin: 0 auto;
    border-radius: 50%; text-align: center; color: #fff; transition: border-color .2s, box-shadow .2s, opacity .25s;
    background: radial-gradient(circle at 35% 30%, rgba(99, 102, 241, .35), rgba(11, 16, 32, .95) 70%); border: 1px solid rgba(165, 180, 252, .45);
    box-shadow: 0 0 0 6px rgba(129, 140, 248, .07), 0 0 60px -10px rgba(129, 140, 248, .7); }
  .dg-root.lit { border-color: rgb(var(--traced) / .8); box-shadow: 0 0 0 6px rgb(var(--traced) / .1), 0 0 60px -10px rgb(var(--traced) / .7); }
  .dg-root b { font-size: 22px; font-weight: 800; line-height: 1.1; }
  .dg-root span { font-size: 12.5px; color: #94a3b8; line-height: 1.35; }
  @media (max-width: 1023px) { .dg-root { width: 170px; } }
  /* a group of nodes in one dashed box with its own head (Pre-rendered animated SVG and its flavours — home and Where it plays) */
  .dg-group { display: flex; flex-direction: column; gap: 8px; padding: 10px; border-radius: 20px; border: 1px dashed rgba(165, 180, 252, .35); background: linear-gradient(rgba(99, 102, 241, .07), rgba(99, 102, 241, .07)), rgba(9, 12, 28, .94); transition: opacity .25s, border-color .2s; }
  .dg-group.lit { border-color: rgb(var(--traced) / .8); }
  /* the head only brings the items together: a quiet label, so the items' own titles carry the meaning (owner) */
  .dg-group-head { display: flex; flex-direction: column; gap: 3px; padding: 2px 6px 2px; color: #fff; text-decoration: none; }
  .dg-group-head b { font-size: 11.5px; font-weight: 700; line-height: 1.3; letter-spacing: .14em; text-transform: uppercase; color: #94a3b8; }
  .dg-group-head span { font-size: 11.5px; color: #64748b; }
  .dg-fork.dg-mini { padding: 8px 14px; border-radius: 12px; }
  .dg-fork.dg-mini b { font-size: 16px; }
  /* a column heading: a big word, a small line */
  .dg-step { display: flex; align-items: baseline; gap: 10px; margin: 0 0 6px; }
  .dg-step b { font-size: clamp(30px, 3.2vw, 40px); font-weight: 800; letter-spacing: -0.02em; background: linear-gradient(90deg, #fff, #c7d2fe); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .dg-step span { font-size: 13px; color: #94a3b8; }
  /* stacked layouts: the small line under the word, clear of the wires down the middle */
  @media (max-width: 1099px) { .dg-step { flex-direction: column; align-items: flex-start; gap: 0; } }
  /* a place: a glyph tile, a name, one small line */
  .dg-place { display: grid; grid-template-columns: 34px minmax(0, 1fr); align-items: center; gap: 10px; padding: 7px 12px 7px 8px; border-radius: 14px; color: #fff;
    background: rgba(15, 23, 42, .78); border: 1px solid rgba(255, 255, 255, .12); transition: opacity .25s, border-color .2s, box-shadow .2s; }
  .dg-place.lit { border-color: rgb(var(--traced) / .8); box-shadow: 0 0 24px -10px rgb(var(--traced) / .7); }
  .dg-glyph { width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center; border-radius: 10px; color: #c7d2fe; background: rgba(129, 140, 248, .12); border: 1px solid rgba(129, 140, 248, .3); }
  .dg-pname { font-size: 15px; font-weight: 800; line-height: 1.2; }
  .dg-place .dg-sub { font-size: 11.5px; }
  .dg-go { width: 30px; height: 30px; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; font-weight: 800; color: #0b1020; background: var(--accent); }
</style>
