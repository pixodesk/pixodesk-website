---
/**
 * A home-page section over the cosmic background (kf scratch hero-bg.mjs `home`), faded at its top and bottom; `label`: an optional tag
 * over it (used while page variants are compared).
 */
interface Props { label?: string; first?: boolean }
const { label, first = false } = Astro.props;
const fade = "linear-gradient(to bottom, transparent, #000 10%, #000 85%, transparent)";
---
<section class:list={["cosmic", first && "first"]}>
  <img src="/assets/index/space-bg.svg" alt="" aria-hidden="true" style={`-webkit-mask-image: ${fade}; mask-image: ${fade}`} />
  {label && <p class="option-label">{label}</p>}
  <div class="cosmic-body"><slot /></div>
</section>

<style>
  .cosmic { position: relative; overflow: hidden; padding: 72px 0 96px; color: #fff; background: linear-gradient(180deg, #000000, #12052a 45%, #000000); }
  .cosmic.first { padding-top: 48px; }
  .cosmic > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
  .cosmic-body { position: relative; z-index: 1; }
  .option-label { position: relative; z-index: 1; margin: 0 auto 28px; width: fit-content; border: 1px solid rgba(251, 191, 36, .45); border-radius: 999px; padding: 3px 12px; font: 600 12px/1.6 ui-monospace, monospace; color: #fde68a; background: rgba(251, 191, 36, .08); }
  .cosmic.first .option-label { margin-top: 24px; }
</style>
