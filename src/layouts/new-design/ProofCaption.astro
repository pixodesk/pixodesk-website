---
/**
 * The line under an illustration that turns it into evidence: which app made it (detected from the file unless given),
 * its size on disk, and a link to the file itself in public/.
 */
import fs from "node:fs";
import { publicFile } from "./publicFile";
interface Props { file: string; app?: string; note?: string; align?: string; light?: boolean }
const { file, app, note, align = "text-center", light = false } = Astro.props;
let size = "";
let madeIn = app ?? "";
try {
  const abs = publicFile(file);
  const bytes = fs.statSync(abs).size;
  size = bytes >= 100 * 1024 ? `${Math.round(bytes / 1024)} KB` : `${(bytes / 1024).toFixed(1)} KB`;
  if (!madeIn) {
    const text = fs.readFileSync(abs, "utf8");
    madeIn = /"st":"none"|lottie/i.test(text) ? "Lottie Animator" : /@keyframes|px-anim|data-px-script/.test(text) ? "SVG Animator" : "SVG Editor";
  }
} catch {
  size = "";
}
const tone = light ? "text-slate-500" : "text-slate-400";
const strong = light ? "text-slate-800" : "text-slate-200";
---
<p class={`${align} mt-3 font-mono text-xs ${tone}`}>
  made in <span class={strong}>{madeIn || "Pixodesk"}</span>{size && <> · {size}</>}{note && <> · <span set:html={note} /></>} · <a class="underline hover:text-white" href={file} target="_blank" rel="noopener">view file</a>
</p>
