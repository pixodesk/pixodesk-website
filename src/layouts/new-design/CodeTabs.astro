---
/** Tabbed code samples (React / Vue / HTML / SVG …), highlighted at build time by Astro's Code component; TabStrip switches them. */
import { Code } from "astro:components";
import TabStrip from "./TabStrip.astro";
import type { TabInfo } from "./tabs";
interface Tab extends TabInfo { lang: "tsx" | "vue" | "html" | "xml" | "bash"; code: string; note?: string; docs?: { label: string; href: string } }
interface Props { tabs: Tab[]; name: string }
const { tabs, name } = Astro.props;
---
<div data-tabs>
  <TabStrip tabs={tabs} name={name} />
  {tabs.map((t, i) => (
    <div role="tabpanel" id={`${name}-panel-${t.id}`} aria-labelledby={`${name}-tab-${t.id}`} data-panel={t.id} hidden={i !== 0}>
      {t.note && <p class="mb-3 text-sm text-custom-grey-200" set:html={t.note} />}
      <div class="overflow-hidden rounded-lg border border-white/10 text-[13px] [&_pre]:overflow-x-auto [&_pre]:p-4"><Code code={t.code} lang={t.lang} theme="github-dark" /></div>
      {t.docs && <p class="mt-3 text-sm"><a class="text-cyan-300 underline" href={t.docs.href}>{t.docs.label} →</a></p>}
    </div>
  ))}
</div>
