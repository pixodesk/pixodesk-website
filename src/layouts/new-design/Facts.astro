---
/** Facts instead of bullets: a glyph tile, a bold lead of a few words, one short line with the key phrase coloured. */
import Glyph from "./Glyph.astro";
import type { GlyphName } from "./glyphs";
export interface FactItem { icon: GlyphName; lead: string; text?: string }
interface Props { items: FactItem[] }
const { items } = Astro.props;
---
<ul class="mt-6 space-y-4">
  {items.map((i) => (
    <li class="flex items-start gap-4">
      <span class="mt-0.5 inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-cyan-300/25 bg-cyan-400/10 text-cyan-200"><Glyph name={i.icon} class="h-5 w-5" /></span>
      <span>
        <span class="block text-[17px] font-semibold leading-tight text-white">{i.lead}</span>
        {i.text && <span class="mt-1 block text-[15px] leading-snug text-custom-grey-200" set:html={i.text} />}
      </span>
    </li>
  ))}
</ul>
