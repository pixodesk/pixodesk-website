---
/** A proof point as a figure, not a paragraph: big figure, one-line label, optional chips and one short line. */
interface Props { figure: string; label: string; chips?: string[]; text?: string }
const { figure, label, chips, text } = Astro.props;
---
<div class="rounded-2xl border border-white/10 bg-white/[.04] p-6 text-center">
  <div class="text-4xl font-black tracking-tight text-white md:text-5xl">{figure}</div>
  <div class="mt-1 font-semibold text-cyan-200">{label}</div>
  {chips && <div class="mt-3 flex flex-wrap justify-center gap-1.5">{chips.map((c) => <span class="rounded-full border border-white/15 bg-black/30 px-2.5 py-0.5 font-mono text-[11px] text-custom-grey-200">{c}</span>)}</div>}
  {text && <p class="mt-3 text-sm leading-snug text-custom-grey-200" set:html={text} />}
</div>
