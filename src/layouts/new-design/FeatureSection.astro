---
/**
 * One feature: the illustration (a real export, with its proof caption) on one side; on the other the title, one line,
 * a mechanism schematic (scene + steps, schemas.ts), the facts as glyph rows and a link to the manual.
 */
import Section from "../Section.astro";
import Border from "../Border.astro";
import Schema from "./Schema.astro";
import Facts, { type FactItem } from "./Facts.astro";
import ProofCaption from "./ProofCaption.astro";
import type { SchemaKind } from "./schemas";
interface Props { title: string; line?: string; schema?: SchemaKind; facts: FactItem[]; file?: string; img?: boolean; html?: string; flip?: boolean; bg?: string; caption?: boolean; docs?: { label: string; href: string } }
const { title, line, schema, facts, file, img = false, html, flip = false, bg = "bg-custom-gradient-navy", caption = true, docs } = Astro.props;
---
<section>
  <Section bgColor={bg} color="text-base-bright" page>
    <Border>
      <div class="grid grid-cols-1 items-center gap-10 md:grid-cols-2 md:gap-14">
        <div class={flip ? "order-1 md:order-2" : "order-1"}>
          <div class="flex justify-center [&_svg]:max-h-[50vh]">{img ? <img src={file} alt={title} /> : <Fragment set:html={html} />}</div>
          {caption && file && <ProofCaption file={file} />}
        </div>
        <div class={flip ? "order-2 md:order-1" : "order-2"}>
          <h2 class="!pb-1">{title}</h2>
          {line && <p class="text-custom-grey-200" set:html={line} />}
          {schema && <Schema kind={schema} />}
          <Facts items={facts} />
          {docs && <p class="mt-5 text-sm"><a class="text-cyan-300 underline underline-offset-2 hover:text-cyan-200" href={docs.href}>{docs.label} →</a></p>}
        </div>
      </div>
    </Border>
  </Section>
</section>
