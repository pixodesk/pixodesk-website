---
/**
 * The card-style tab buttons shared by CodeTabs and VideoSection. Place it inside an element with `data-tabs`; the
 * panels there carry role="tabpanel" + data-panel="<tab id>". A click shows that panel, hides the others and pauses
 * any video in them. The first tab starts selected.
 */
import Glyph from "./Glyph.astro";
import type { TabInfo } from "./tabs";
interface Props { tabs: TabInfo[]; name: string }
const { tabs, name } = Astro.props;
const columns = tabs.length === 2 ? "mx-auto max-w-xl grid-cols-2" : tabs.length === 3 ? "grid-cols-1 md:grid-cols-3" : tabs.length === 5 ? "grid-cols-2 md:grid-cols-5" : "grid-cols-2 md:grid-cols-4";
---
<div role="tablist" class={`mb-4 grid gap-2 ${columns}`}>
  {tabs.map((t, i) => (
    <button type="button" role="tab" id={`${name}-tab-${t.id}`} aria-controls={`${name}-panel-${t.id}`} aria-selected={i === 0 ? "true" : "false"} data-tab={t.id}
      class="flex items-center gap-3 rounded-xl border border-white/10 bg-white/[.04] p-3 text-left text-custom-grey-400 transition hover:bg-white/[.08] hover:text-white aria-selected:border-cyan-300/50 aria-selected:bg-cyan-400/10 aria-selected:text-white">
      {t.glyph && <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-black/30 text-cyan-200"><Glyph name={t.glyph} class="h-[18px] w-[18px]" /></span>}
      <span><span class="block text-sm font-semibold leading-tight">{t.label}</span>{t.hint && <span class="block text-xs leading-snug opacity-80">{t.hint}</span>}</span>
    </button>
  ))}
</div>
<script>
  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((root) => {
    const tabs = root.querySelectorAll<HTMLButtonElement>("[role=tab]");
    const panels = root.querySelectorAll<HTMLElement>("[role=tabpanel]");
    tabs.forEach((btn) => btn.addEventListener("click", () => {
      tabs.forEach((b) => b.setAttribute("aria-selected", String(b === btn)));
      panels.forEach((p) => {
        p.hidden = p.dataset.panel !== btn.dataset.tab;
        if (p.hidden) p.querySelectorAll("video").forEach((v) => v.pause());
      });
    }));
  });
</script>
