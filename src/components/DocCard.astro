---
/**
 * A linked card for the docs landing page: icon chip, title with a hover
 * arrow, and a slotted description. Starlight's LinkCard with more visual
 * interest; colours come from Starlight vars so both themes work.
 */
import { Icon } from '@astrojs/starlight/components';

interface Props {
    title: string;
    href: string;
    icon: string;
}

const { title, href, icon } = Astro.props;
---

<a class="doc-card" href={href}>
    <span class="doc-card-icon"><Icon name={icon} size="1.5rem" /></span>
    <span class="doc-card-body">
        <span class="doc-card-title">
            {title}
            <span class="doc-card-arrow" aria-hidden="true">→</span>
        </span>
        <span class="doc-card-desc"><slot /></span>
    </span>
</a>

<style>
    .doc-card {
        display: flex;
        gap: 1rem;
        height: 100%;
        padding: 1.25rem;
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 0.75rem;
        background: linear-gradient(
            145deg,
            var(--sl-color-black),
            var(--sl-color-gray-6)
        );
        text-decoration: none;
        color: var(--sl-color-gray-2);
        transition:
            border-color 0.2s,
            transform 0.2s,
            box-shadow 0.2s;
    }

    .doc-card:hover {
        border-color: var(--sl-color-accent-high);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
    }

    .doc-card-icon {
        flex: none;
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 0.6rem;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--sl-color-accent-low);
        color: var(--sl-color-accent-high);
    }

    .doc-card-title {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        font-weight: 600;
        font-size: 1.05rem;
        color: var(--sl-color-white);
    }

    .doc-card-arrow {
        opacity: 0;
        transform: translateX(-4px);
        transition:
            opacity 0.2s,
            transform 0.2s;
        color: var(--sl-color-accent-high);
    }

    .doc-card:hover .doc-card-arrow {
        opacity: 1;
        transform: none;
    }

    .doc-card-desc {
        display: block;
        margin-top: 0.35rem;
        font-size: 0.875rem;
        line-height: 1.5;
    }
</style>
