{
  "name": "pixodesk2",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "sync:svga-docs": "node scripts/sync-svga-docs.mjs",
    "sync:svga-docs:github": "rm -rf .tmp-svga-docs && mkdir -p .tmp-svga-docs && curl -fsSL https://github.com/pixodesk/pixodesk-svg-animator/archive/refs/heads/main.tar.gz | tar -xz -C .tmp-svga-docs --strip-components=2 pixodesk-svg-animator-main/docs && node scripts/sync-svga-docs.mjs .tmp-svga-docs && rm -rf .tmp-svga-docs",
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "docs:check-images": "node scripts/check-docs-images.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/react": "^4.3.0",
    "@astrojs/starlight": "^0.37.3",
    "@astrojs/tailwind": "^6.0.2",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/typography": "^0.5.19",
    "astro": "^5.13.5",
    "js-yaml": "^4.1.0",
    "mermaid": "^11.17.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@modyfi/vite-plugin-yaml": "^1.1.1",
    "@playwright/test": "^1.59.1",
    "autoprefixer": "^10.4.21",
    "less": "^4.4.1",
    "marked": "^16.3.0",
    "sass": "^1.93.2",
    "tailwindcss": "3"
  }
}
